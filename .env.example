# OpenRouter（必填，統一 LLM 入口；可使用 Gemini Flash Lite/DeepSeek 等便宜模型）
OPENROUTER_API_KEY=sk-or-v1-...

# OpenRouter 路由元資料（選填，用於 leaderboard 與限流追蹤）
OPENROUTER_REFERER=https://github.com/jack926509/us-stock-newsletter
OPENROUTER_APP_TITLE=US Stock Newsletter

# Finnhub 市場數據 + 新聞 (必填)
FINNHUB_API_KEY=...

# Tavily 深度搜尋 (必填)
TAVILY_API_KEY=tvly-...

# Telegram (必填)
TELEGRAM_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=-100123456789

# ─── LLM 模型選擇（皆為 OpenRouter 模型 ID，預設便宜版本） ────
# 可至 https://openrouter.ai/models 查詢可用模型與單價
PLANNER_MODEL=google/gemini-2.5-flash-lite
WRITER_MODEL=google/gemini-2.5-flash-lite
EDITOR_MODEL=google/gemini-2.5-flash

# 排程設定 (有預設值)
CRON_HOUR=8
CRON_MINUTE=0
TIMEZONE=Asia/Taipei

# Web Server 設定 (選填)
PORT=8080
ADMIN_API_KEY=my-secret-key-for-manual-trigger

# ─── ai-hedge-fund 整合（全部選填） ────────────────────────────
# 只有 watchlist.json 含非免費 ticker 時才需要；免費層覆蓋 AAPL/MSFT/NVDA/GOOGL/TSLA
# FINANCIAL_DATASETS_API_KEY=

# 啟用的分析師（逗號分隔）。canonical key 對應 ai-hedge-fund 上游：
#   warren_buffett, fundamentals_analyst, technical_analyst, sentiment_analyst,
#   peter_lynch, charlie_munger, stanley_druckenmiller, news_sentiment_analyst, valuation_analyst, growth_analyst, ...
# 也接受短別名 fundamentals/technicals/sentiment（adapter 會自動轉換）。
HEDGE_FUND_ANALYSTS=warren_buffett,fundamentals_analyst,technical_analyst,sentiment_analyst

# ai-hedge-fund 內部呼叫的模型（OpenRouter ID；預設便宜版本）
HEDGE_FUND_MODEL=google/gemini-2.5-flash-lite

# 整輪 ai-hedge-fund 分析的超時秒數
HEDGE_FUND_TIMEOUT=240

# 自選股檔案路徑（相對 repo 根目錄），正常不用改
WATCHLIST_PATH=watchlist.json
