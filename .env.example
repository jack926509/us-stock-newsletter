# OpenAI（必填，統一 LLM 入口；預設模型為 gpt-4o-mini）
OPENAI_API_KEY=sk-...

# Finnhub 市場數據 + 新聞 (必填)
FINNHUB_API_KEY=...

# Tavily 深度搜尋 (必填)
TAVILY_API_KEY=tvly-...

# Slack (必填)
# Bot Token：從 https://api.slack.com/apps 建立 App → OAuth & Permissions
# 需要的 Bot Token Scopes：chat:write（必要）、chat:write.public（選填，可推送到未邀請的公開頻道）
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
# 推送目標：建議填頻道 ID（如 C0123456789），也接受 #channel-name
# 若是 private channel 必須先把 Bot /invite 進去
SLACK_CHANNEL=C0123456789

# Slack Signing Secret（選填；要用 /newsletter slash command 才需要）
# 從 Slack App → Basic Information → App Credentials → Signing Secret
SLACK_SIGNING_SECRET=

# PostgreSQL（選填；設定後 watchlist 改存 DB 取代檔案模式）
# Zeabur Postgres：用 ${POSTGRES_CONNECTION_STRING} 注入；本地 dev 不必填
# 例：postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# Watchlist 檔案路徑（選填；預設 watchlist.json）
# - DATABASE_URL 未設時：watchlist 寫入這個檔案
# - DATABASE_URL 有設時：只當作首次啟動的 seed 來源（DB 空時自動匯入）
WATCHLIST_PATH=watchlist.json

# ─── LLM 模型選擇（OpenAI 模型 ID，預設便宜版本） ──────────────
# 想再省可改 gpt-4.1-nano；想要更高品質可改 gpt-4.1-mini / gpt-4o
PLANNER_MODEL=gpt-4o-mini
WRITER_MODEL=gpt-4o-mini
EDITOR_MODEL=gpt-4o-mini

# 排程設定 (有預設值)
CRON_HOUR=8
CRON_MINUTE=0
TIMEZONE=Asia/Taipei

# Web Server 設定 (選填)
PORT=8080
ADMIN_API_KEY=my-secret-key-for-manual-trigger

# ─── ai-hedge-fund 整合（全部選填） ────────────────────────────
# 只有 watchlist.json 含非免費 ticker 時才需要；免費層覆蓋 AAPL/MSFT/NVDA/GOOGL/TSLA
# FINANCIAL_DATASETS_API_KEY=

# 啟用的分析師（逗號分隔）。canonical key 對應 ai-hedge-fund 上游：
#   warren_buffett, fundamentals_analyst, technical_analyst, sentiment_analyst,
#   peter_lynch, charlie_munger, stanley_druckenmiller, news_sentiment_analyst, valuation_analyst, growth_analyst, ...
# 也接受短別名 fundamentals/technicals/sentiment（adapter 會自動轉換）。
HEDGE_FUND_ANALYSTS=warren_buffett,fundamentals_analyst,technical_analyst,sentiment_analyst

# ai-hedge-fund 內部呼叫的 OpenAI 模型
HEDGE_FUND_MODEL=gpt-4o-mini

# 整輪 ai-hedge-fund 分析的超時秒數
HEDGE_FUND_TIMEOUT=240

