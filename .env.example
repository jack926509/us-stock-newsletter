# Anthropic (必填)
ANTHROPIC_API_KEY=sk-ant-...

# Finnhub 市場數據 + 新聞 (必填)
FINNHUB_API_KEY=...

# Tavily 深度搜尋 (必填)
TAVILY_API_KEY=tvly-...

# Telegram (必填)
TELEGRAM_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=-100123456789

# 排程設定 (有預設值)
CRON_HOUR=8
CRON_MINUTE=0
TIMEZONE=Asia/Taipei

# Web Server 設定 (選填)
PORT=8080
ADMIN_API_KEY=my-secret-key-for-manual-trigger

# ─── ai-hedge-fund 整合（全部選填） ────────────────────────────
# 只有 watchlist.json 含非免費 ticker 時才需要；免費層覆蓋 AAPL/MSFT/NVDA/GOOGL/TSLA
# FINANCIAL_DATASETS_API_KEY=

# 啟用的分析師（逗號分隔）；可改全明星 warren_buffett,peter_lynch,charlie_munger,stanley_druckenmiller,fundamentals,technicals,sentiment
HEDGE_FUND_ANALYSTS=warren_buffett,fundamentals,technicals,sentiment

# ai-hedge-fund 內部呼叫的 Claude 模型（haiku 最便宜、sonnet 品質較好）
HEDGE_FUND_MODEL=claude-haiku-4-6

# 整輪 ai-hedge-fund 分析的超時秒數
HEDGE_FUND_TIMEOUT=240

# 自選股檔案路徑（相對 repo 根目錄），正常不用改
WATCHLIST_PATH=watchlist.json
