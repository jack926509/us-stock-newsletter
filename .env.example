# Anthropic (必填)
ANTHROPIC_API_KEY=sk-ant-...

# Finnhub 市場數據 + 新聞 (必填)
FINNHUB_API_KEY=...

# Tavily 深度搜尋 (必填)
TAVILY_API_KEY=tvly-...

# Telegram (必填)
TELEGRAM_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=-100123456789

# 排程設定 (有預設值)
CRON_HOUR=8
CRON_MINUTE=0
TIMEZONE=Asia/Taipei

# Web Server 設定 (選填)
PORT=8080
ADMIN_API_KEY=my-secret-key-for-manual-trigger
