# OpenAI (必填)
OPENAI_API_KEY=sk-...

# Finnhub 市場數據 + 新聞 (必填)
FINNHUB_API_KEY=...

# Tavily 深度搜尋 (必填)
TAVILY_API_KEY=tvly-...

# Telegram (必填)
TELEGRAM_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=-100123456789

# 排程設定 (有預設值)
CRON_HOUR=7
CRON_MINUTE=30
TIMEZONE=America/New_York

# Web Server 設定 (選填)
PORT=8080
ADMIN_API_KEY=my-secret-key-for-manual-trigger

# Email 發送設定 (選填：有設定才會寄信)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_RECIPIENT=xieh.gemini@gmail.com
